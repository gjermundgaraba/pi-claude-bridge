  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/pi-claude-bridge.git"
  },
  "files": [
    "bash-timeout.ts",
    "child.ts",
    "content.ts",
    "docs",
    "index.ts",
    "json.ts",
    "log.ts",
    "machine",
    "mcp-server.ts",
    "models.ts",
    "prompt.ts",
    "provider.ts",
    "query",
    "session",
    "sessions.ts",
    "sync.ts",
    "text.ts",
    "tools.ts",
    "translate.ts",
    "turn.ts",
    "README.md",
    "LICENSE",
    "LICENSE.pi-claude-bridge"
  ],
  "type": "module",
  "exports": "./index.ts",
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --no-typescript --oxlint --tsrs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "@modelcontextprotocol/sdk": "1.32.2",
    "cc-session-io": "0.4.1",
    "xstate": "6.0.0-beta.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@clanker-stuff/oxlint-config": "0.5.1",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@effect/tsgo": "0.73.2",
    "@types/node": "26.6.6",
    "typebox": "1.4.7",
    "typescript": "7.0.2",
    "ultracite": "8.3.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
